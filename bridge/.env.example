# Copy this file to .env and fill in deployment-specific values.
# Never commit .env. See DEPLOYER_CONFIGURATION.md for where each value comes from.

# ===== Teams / Bot Framework =====
# MicrosoftAppId comes from the Azure Bot/App Registration app id.
# MicrosoftAppPassword is a client secret created for that app registration.
MicrosoftAppType=MultiTenant
MicrosoftAppId=<your-bot-app-client-id>
MicrosoftAppPassword=<your-bot-app-client-secret>
MicrosoftAppTenantId=

# ===== Azure OpenAI / model selection =====
# Use the endpoint and deployment name for your Azure OpenAI or Azure AI Foundry model deployment.
AZURE_OPENAI_ENDPOINT=https://<your-openai-or-foundry-resource>.services.ai.azure.com/
AZURE_OPENAI_MODEL=<your-model-deployment-name>
AZURE_OPENAI_API_VERSION=2024-06-01
# Optional. Leave empty if your deployment uses AAD auth instead of API key auth.
AZURE_OPENAI_API_KEY=

# ===== Azure AI Foundry (brain_maf.py) =====
# Required. Foundry project endpoint, usually https://<resource>.services.ai.azure.com/api/projects/<project>.
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>
# Required. Service principal used by the bot to call the Foundry project.
FOUNDRY_TENANT_ID=<your-foundry-sp-tenant-id>
FOUNDRY_CLIENT_ID=<your-foundry-sp-client-id>
FOUNDRY_CLIENT_SECRET=<your-foundry-sp-client-secret>

# ===== Azure Bot endpoint auto update (launch-bridge.ps1) =====
# Optional but recommended. Full Azure resource id of the Bot Service resource to update.
BOT_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.BotService/botServices/<bot-name>
# Optional. Reuse a named dev tunnel for a more stable public URL.
DEVTUNNEL_NAME=
# Optional but recommended. Management-plane SP with permission to update BOT_RESOURCE_ID.
MGMT_SP_TENANT_ID=<your-management-sp-tenant-id>
MGMT_SP_CLIENT_ID=<your-management-sp-client-id>
MGMT_SP_CLIENT_SECRET=<your-management-sp-client-secret>

# ===== Azure customer data-plane query fallback =====
# Optional. If unset, Azure SDK falls back to DefaultAzureCredential / az login.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ===== Kusto/ADX telemetry =====
# Optional defaults used when a tool call does not pass cluster/database explicitly.
KUSTO_CLUSTER_URL=https://<cluster>.kusto.windows.net
KUSTO_DATABASE=<database-name>
# Optional. Dedicated Kusto SP. If unset, Kusto uses az login via Azure CLI.
KUSTO_TENANT_ID=
KUSTO_CLIENT_ID=
KUSTO_CLIENT_SECRET=
# Optional. Tenant used by az CLI token acquisition for Kusto.
KUSTO_AZ_TENANT_ID=

# ===== Local runtime behavior =====
PORT=3978
NANITE_DEEP_MODE_ENABLED=true
DELEGATED_AUTH_TTL_MINUTES=0
SHOW_TRACE=true
RUN_LOG_ENABLED=true
