{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${PLUGIN_ROOT}/hooks/scripts/pre-tool-use.ps1\"",
            "bash": "bash \"${PLUGIN_ROOT}/hooks/scripts/pre-tool-use.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${PLUGIN_ROOT}/hooks/scripts/post-tool-use.ps1\"",
            "bash": "bash \"${PLUGIN_ROOT}/hooks/scripts/post-tool-use.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${PLUGIN_ROOT}/hooks/scripts/session-start.ps1\"",
            "bash": "bash \"${PLUGIN_ROOT}/hooks/scripts/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
