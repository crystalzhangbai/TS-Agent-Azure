  {
    "id": "fc716b5e-b66f-4ebf-baab-6745742482aa",
    "name": "Incoming Requests",
    "groupId": "b4453598-8fe9-4146-a196-9ca9850e93cf",
    "majorVersion": 3,
    "minorVersion": 3,
    "cluster": "armprodgbl.eastus",
    "database": "ARMProd",
    "type": "Table",
    "dataSource": "Kusto",
    "language": "KQL",
    "kustoQuery": "macro-expand isfuzzy=true ARMProdEG as X\n(\n    X.database('Requests').HttpIncomingRequests\n    | where TIMESTAMP between ((queryFrom - 12h) .. (queryTo + 12h))\n    | where correlationId == queryCorrelationId and isnotempty(queryCorrelationId)\n    | where httpStatusCode > -1\n    | extend duration = tostring(split(durationInMilliseconds * 1ms, '.')[0])\n    | project-reorder TIMESTAMP, ActivityId, correlationId, authorizationAction, operationName, httpStatusCode, targetUri, duration, RoleLocation, Role\n    | extend short_activity = substring(ActivityId, 0, 13)\n    | extend level = case(\n        httpStatusCode >= 500, 'error', \n        httpStatusCode >= 400, 'warning', \n        ''\n    )\n    | where not(qFilter == 'errors') or isnotempty(level)\n)\n| order by TIMESTAMP asc\n",
    "params": [
      {
        "name": "queryFrom",
        "description": "The ASI team recommends that all queries have a start and end time and these are linked to the GlobalTime",
        "type": "datetime",
        "default": "2023-05-07T10:17:11.113Z",
        "optional": false,
        "useTestValueAsDefault": false,
        "typeSpecificOptions": {
          "enumTypeData": "[]"
        },
        "displayConditions": []
      },
      {
        "name": "queryTo",
