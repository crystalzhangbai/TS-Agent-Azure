    "VIP > Offline Task (vipmanager) vs Sync (svimanager) Release": {
      "panelPath": [
        "VIP",
        "Offline Task (vipmanager) vs Sync (svimanager) Release"
      ],
      "queries": [
        {
          "id": "af039d18-8885-4dae-a1d0-15a5ec173dfe",
          "name": "VIP Release Offline vs Sync",
          "groupId": "cb3319ea-abc7-47ed-aec5-738c2d31ee4c",
          "majorVersion": 1,
          "minorVersion": 0,
          "cluster": "https://nrp.kusto.windows.net/",
          "database": "mdsnrp",
          "type": "Table",
          "widgetType": "Table",
          "widgetTitle": "Offline Task (vipmanager) vs Sync (svimanager) Release",
          "params": [
            {
              "name": "queryFrom",
              "type": "datetime",
              "optional": false
            },
            {
              "name": "queryTo",
              "type": "datetime",
              "optional": false
            },
            {
              "name": "querySubscription",
              "type": "string",
              "optional": false
            },
            {
              "name": "queryRegion",
              "type": "string",
              "optional": false
            }
          ],
          "schema": [
            {
              "name": "ReleaseType",
              "type": "string"
            },
            {
              "name": "count_",
              "type": "long"
            },
            {
              "name": "percentTotal",
              "type": "long"
            }
          ],
          "inputMappings": [
            {
              "source": "asi_values",
              "majorVersion": 0,
              "minorVersion": 0,
              "internalDestinationName": "queryFrom",
              "externalSourceName": "globalFrom",
              "required": false,
              "multipleValuesProcessingMode": "PassValuesIntoOneField"
            },
            {
              "source": "asi_values",
              "majorVersion": 0,
              "minorVersion": 0,
              "internalDestinationName": "queryTo",
              "externalSourceName": "globalTo",
              "required": false,
              "multipleValuesProcessingMode": "PassValuesIntoOneField"
            },
            {
              "source": "page",
              "majorVersion": 0,
              "minorVersion": 0,
              "internalDestinationName": "querySubscription",
              "externalSourceName": "querySubscription",
              "required": false,
              "multipleValuesProcessingMode": "PassValuesIntoOneField"
            },
            {
              "source": "page",
              "majorVersion": 0,
              "minorVersion": 0,
              "internalDestinationName": "queryRegion",
              "externalSourceName": "queryRegion",
              "required": false,
              "multipleValuesProcessingMode": "PassValuesIntoOneField"
            }
          ],
          "kustoQuery": "let allocatedIps =FrontendOperationEtwEvent\r\n| where TIMESTAMP between (queryFrom ..queryTo )\r\n| where queryRegion == \"*\" or Region == queryRegion\r\n| where querySubscription == \"*\" or SubscriptionId == querySubscription\r\n| where Message startswith \"Offline tasks persisted for release of VipAllocation with id \"\r\n| extend ReleaseType=\"Offline Task\"\r\n| summarize count() by ReleaseType\r\n;\r\nlet reservedIps = FrontendOperationEtwEvent\r\n| where TIMESTAMP between (queryFrom ..queryTo )\r\n| where queryRegion == \"*\" or Region == queryRegion\r\n| where querySubscription == \"*\" or SubscriptionId == querySubscription\r\n| where Message startswith \"Released ipaddress \"\r\n| extend ReleaseType=\"Synchronous\"\r\n| summarize count() by ReleaseType\r\n| union allocatedIps\r\n;\r\nlet totalCount= toscalar(\r\nreservedIps\r\n| summarize sum(count_))\r\n;\r\nreservedIps\r\n| extend percentTotal = count_*100/totalCount\r\n;",
          "panelPath": [
            "VIP",
            "Offline Task (vipmanager) vs Sync (svimanager) Release"
          ]
        }
      ]
    },
    "VIP > Put/Delete Public IP +VIP Related QOS Errors": {
      "panelPath": [
