              "type": "string"
            },
            {
              "name": "ReleaseBuilds",
              "type": "string"
            },
            {
              "name": "ExampleError",
              "type": "string"
            }
          ],
          "inputMappings": [
            {
              "source": "asi_values",
              "majorVersion": 0,
              "minorVersion": 0,
              "internalDestinationName": "queryFrom",
              "externalSourceName": "globalFrom",
              "required": false,
              "multipleValuesProcessingMode": "PassValuesIntoOneField"
            },
            {
              "source": "asi_values",
              "majorVersion": 0,
              "minorVersion": 0,
              "internalDestinationName": "queryTo",
              "externalSourceName": "globalTo",
              "required": false,
              "multipleValuesProcessingMode": "PassValuesIntoOneField"
            },
            {
              "source": "page",
              "majorVersion": 0,
              "minorVersion": 0,
              "internalDestinationName": "queryRegion",
              "externalSourceName": "queryRegion",
              "required": false,
              "multipleValuesProcessingMode": "PassValuesIntoOneField"
            }
          ],
          "kustoQuery": "QosEtwEvent \r\n| where TIMESTAMP between (queryFrom ..queryTo )\r\n| where queryRegion == \"*\" or Region == queryRegion\r\n| where OperationName == \"PutPublicIpAddressOperation\"  or OperationName == \"DeletePublicIpAddressOperation\" \r\n    or ErrorDetails contains \"TransferFastPathPublicIPAddresses\" \r\n    or ErrorDetails contains \"TransferVipResourceIpAndPollForCompletionAsync\" \r\n    or ErrorDetails contains \"VipAllocationToTr|ansfer\" \r\n    or ErrorDetails contains \"AllocatePublicIpAndPersistIfRequired\" \r\n    or ErrorDetails contains \"ReleasePublicIPAllocationOfflineAsync\" \r\n   // or ErrorDetails contains \"AllocateVipPrefixInRNM\" \r\n   // or ErrorDetails contains \"ReleaseVipAllocationPrefixAsync\" \r\n    or ErrorDetails contains \"ReleasePublicIpAsync\"\r\n    or ErrorDetails contains \"ReservePublicIpAsync\"\r\n| where Success == false \r\n| where UserError == false \r\n| extend containsParentOperation = ParentOperationId != \"\" \r\n| where ErrorDetails !contains \"FabricNotPrimaryException\"  \r\n    and ErrorCode != \"TaskCanceled\"  \r\n    and ErrorCode != \"PrimaryFailover\"  \r\n    and ErrorDetails !startswith \"System.OperationCanceledException: \"  \r\n    and ErrorDetails !startswith \"Microsoft.WindowsAzure.Networking.Nrp.Frontend.Common.NrpException: Primay role \" \r\n    and ErrorDetails !startswith \"System.Fabric.FabricTransientException: The operation failed because this replica set is currently reconfiguring.\"\r\n| extend errorType = case( \r\n    ErrorDetails contains \"There is no more VipAllocationService Uri with the current VIpClassification to try but still cannot allocate Vip address.\", \"Unable To Allocate\", \r\n    ErrorDetails contains \"Microsoft.Windows.Azure.Networking.Dns.Common.DnsResolver.DnsQueryException: Failed to query the DNS server at ''\", \"DNS Failed To Query The Server\", \r\n    ErrorDetails contains \"System.ArgumentException: vipTags must not be specified along with vipPrefixAllocationId\", \"VIP With Prefix Not Released In Time\", \r\n    ErrorDetails contains \"System.Net.WebException: Unable to connect to the remote server ---> System.Net.Sockets.\" and ErrorDetails contains \"DNS Facade\", \"dnsSocketException\", \r\n    ErrorDetails contains \"Vip reservation already exists for specified IPAddress\" and ErrorDetails contains \"TransferVipReservationAsync\", \"Reservation Already Exists For Transfer Api\", \r\n    ErrorDetails contains \"Error in CreateOrUpdateSlbServiceAsync :\", \"SLB Update Error\", \r\n    ErrorDetails contains \"SlbFacade.<DeleteSlbServiceAsync>\", \"SLB Delete Error\", \r\n    ErrorDetails contains \"This resource reference is a stub.\" and ErrorDetails contains \"prefixes/\" and ErrorDetails contains \"TransferVipResourceIpAndPollForCompletionAsync\", \"Transfer Api Null Ref For PublicIP Prefix\", \r\n    ErrorDetails contains \"No range found that can satisfy the allocation request.\" and ErrorDetails contains \"AllocateVipsInternal\", \"Vip Allocation No Range Found Error\", // why would we get this error if we have already gone to that vipManager? Race condition? \r\n    ErrorDetails contains \"Parameter name: vipAddress ---> System.ServiceModel.FaultException`1[Microsoft.WindowsAzure.Networking.Rnm.Contracts.Faults.VipManagementFault]: Value cannot be null.\", \"Vip Reservation Ip Address Value Is Null\", \r\n    \"Other\" \r\n) \r\n| where ClientAppId !in (\"a43ddf50-441a-442c-8e60-c423ceae1595\",\"237794b4-a7ac-4073-96c6-38f0cfddd8cf\",\"093a0dd8-9cae-4e29-a1c4-c2dc47bd2508\",\"f81873a0-342e-4769-a266-7159ac4e8cd4\") // client app id excluded\r\n// | project Region,ErrorCode, ErrorDetails, containsParentOperation, OperationName, SourceAssemblyFileVersion, SubscriptionId, OperationId, ClientAppId\r\n| summarize count(), make_set(ErrorDetails), make_set(Region), ReleaseBuilds = make_set(ReleaseBuild((SourceAssemblyFileVersion))) by errorType, containsParentOperation, OperationName\r\n| summarize by count_, errorType, OperationName, containsParentOperation, Regions = tostring(set_Region), ReleaseBuilds = tostring(ReleaseBuilds), ExampleError = substring(tostring(set_ErrorDetails[0]), 0, 500)\r\n| sort by count_ desc ",
          "panelPath": [
            "VIP",
            "Put/Delete Public IP +VIP Related QOS Errors"
          ]
        }
      ]
    },
