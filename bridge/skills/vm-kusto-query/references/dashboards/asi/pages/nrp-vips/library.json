          "groupId": "dc5cccd9-6991-407e-b3f8-744a2a465c71",
          "majorVersion": 1,
          "minorVersion": 3,
          "cluster": "https://nrp.kusto.windows.net/",
          "database": "mdsnrp",
          "type": "Table",
          "widgetType": "Table",
          "widgetTitle": "Put/Delete Public IP +VIP Related QOS Errors",
          "params": [
            {
              "name": "queryFrom",
              "type": "datetime",
              "optional": false
            },
            {
              "name": "queryTo",
              "type": "datetime",
              "optional": false
            },
            {
              "name": "queryRegion",
              "type": "string",
              "optional": false
            }
          ],
          "schema": [
            {
              "name": "count_",
              "type": "long"
            },
            {
