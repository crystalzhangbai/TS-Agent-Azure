  {
    "id": "26cac939-a0fe-48e9-a292-ab27f15a071c",
    "name": "VMManagedDisksAllocationInfo",
    "groupId": "4bc50b54-44ac-4363-aef7-8d8879066508",
    "majorVersion": 1,
    "minorVersion": 1,
    "cluster": "Azcrpbifollower",
    "database": "bi_allprod",
    "type": "Table",
    "dataSource": "Kusto",
    "language": "KQL",
    "kustoQuery": "let crpDisks = VMManagedDisksAllocationInfo\r\n| where PreciseTimeStamp between(queryFrom .. queryTo)\r\n| where VMId == queryVMId\r\n| summarize SnapshotTime = arg_max(PreciseTimeStamp, *) by CrpDiskId = DiskId;\r\nlet crpDiskIds = crpDisks | project CrpDiskId;\r\nlet disksBi  = cluster(\"DisksBi\").database(\"DisksBi\").Disk\r\n| where PreciseTimeStamp between(queryFrom .. queryTo)\r\n| where CrpDiskId in (crpDiskIds)\r\n| distinct CrpDiskId, DisksId;\r\ncrpDisks | join kind= fullouter disksBi on CrpDiskId\r\n| extend diskResoureArray = split(CsmResourceId, \"/\")\r\n| extend diskCsmSubId = tolower(diskResoureArray[2])\r\n| extend diskCsmResourceGroup = tolower(diskResoureArray[4])\r\n| extend diskCsmResourceName = tolower(diskResoureArray[8])",
    "params": [
      {
        "name": "queryFrom",
        "description": "The ASI team recommends that all queries have a start and end time and these are linked to the GlobalTime",
        "type": "datetime",
        "default": "2025-02-04T03:39:45.000Z",
        "optional": false,
        "useTestValueAsDefault": false,
        "typeSpecificOptions": {
          "enumTypeData": "[]"
        },
        "displayConditions": []
      },
