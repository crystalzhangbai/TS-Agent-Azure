            },
            {
              "source": "asi_values",
              "majorVersion": 0,
              "minorVersion": 0,
              "internalDestinationName": "queryTo",
              "externalSourceName": "globalTo",
              "required": false
            }
          ],
          "kustoQuery": "let totalCount = HttpAccessLog\r\n| where activitytimestamp > ago(1d)\r\n| where log contains \"/healthcheck HTTP/1.1\"\r\n| summarize total_count = count() by RPTenant, total_time_bin=bin(activitytimestamp, 1h);\r\nlet healthyCount = HttpAccessLog\r\n| where activitytimestamp > ago(1d)\r\n| where log contains \"/healthcheck HTTP/1.1\\\" 200 2\"\r\n| summarize healthy_count = count() by RPTenant, healthy_time_bin=bin(activitytimestamp, 1h);\r\ntotalCount\r\n| join kind=inner healthyCount on $left.total_time_bin == $right.healthy_time_bin, RPTenant\r\n| extend ratio = (1.0 - round(1.0 * healthy_count/total_count, 3))*100\r\n| project RPTenant, ratio, healthy_time_bin",
          "panelPath": []
        }
      ]
    }
