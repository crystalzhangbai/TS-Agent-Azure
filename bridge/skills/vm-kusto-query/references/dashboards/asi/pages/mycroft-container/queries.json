  {
    "id": "0cc1394a-3c3c-473c-849f-57426a4d0e63",
    "name": "Container LifecycleState Timeline",
    "groupId": "8e465b74-28f2-45b3-a661-068e59677e3e",
    "majorVersion": 1,
    "minorVersion": 1,
    "cluster": "mycroft.westcentralus.kusto.windows.net",
    "database": "Mycroft",
    "type": "Timeline",
    "dataSource": "Kusto",
    "language": "KQL",
    "kustoQuery": "cluster(\"mycroft.westcentralus\").database(\"Mycroft\").MycroftContainerHealthSnapshot\r\n| where ContainerId == queryContainerId\r\n| project LifecycleState, PreciseTimeStamp\r\n| order by PreciseTimeStamp asc\r\n| where \r\n    isnull(prev(PreciseTimeStamp)) or isnull(next(PreciseTimeStamp)) or \r\n    (LifecycleState != prev(LifecycleState) or LifecycleState != next(LifecycleState))\r\n| extend StartTime = PreciseTimeStamp\r\n| extend EndTime = next(PreciseTimeStamp)\r\n| where next(LifecycleState) == LifecycleState or isempty(next(LifecycleState))\r\n| extend EndTime = iif(isnull(EndTime), datetime_add('minute', 1, StartTime), EndTime)\r\n| project StartTime, EndTime, Content = LifecycleState\r\n",
    "params": [
      {
        "name": "queryContainerId",
        "type": "string",
        "optional": false,
        "useTestValueAsDefault": false,
        "typeSpecificOptions": {},
        "displayConditions": []
      }
    ],
    "schema": [
      {
        "name": "StartTime",
        "type": "datetime"
      },
      {
        "name": "EndTime",
        "type": "datetime"
      },
      {
        "name": "Content",
        "type": "string"
      }
    ],
    "serviceId": "Mycroft"
  }
