          "groupId": "41761c62-241d-49f5-84a2-32af92123d70",
          "majorVersion": 1,
          "minorVersion": 4,
          "cluster": "azcrp.kusto.windows.net",
          "database": "vmimagebuilder",
          "type": "Table",
          "widgetType": "Table",
          "widgetTitle": "AsyncQos",
          "params": [
            {
              "name": "queryFrom",
              "type": "datetime",
