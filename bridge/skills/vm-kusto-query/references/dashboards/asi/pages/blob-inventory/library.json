              "name": "SloMet",
              "type": "long"
            },
            {
              "name": "SloNotMet",
              "type": "long"
            },
            {
              "name": "percentile_BilledObjectsCount_50",
              "type": "real"
            },
            {
              "name": "percentile_ObjectCountFromBilling_50",
              "type": "real"
            },
            {
              "name": "MetSloRetio",
              "type": "real"
            }
          ],
          "inputMappings": [
            {
              "source": "asi_values",
              "majorVersion": 0,
              "minorVersion": 0,
              "internalDestinationName": "queryFrom",
              "externalSourceName": "globalFrom",
              "required": false,
              "multipleValuesProcessingMode": "PassValuesIntoOneField"
            },
            {
              "source": "asi_values",
              "majorVersion": 0,
              "minorVersion": 0,
              "internalDestinationName": "queryTo",
              "externalSourceName": "globalTo",
              "required": false,
              "multipleValuesProcessingMode": "PassValuesIntoOneField"
            },
            {
              "source": "page",
              "majorVersion": 0,
              "minorVersion": 0,
              "internalDestinationName": "storageAccountName",
              "externalSourceName": "StorageAccountName",
              "required": false,
              "multipleValuesProcessingMode": "PassValuesIntoOneField"
            },
            {
              "source": "page",
              "majorVersion": 0,
              "minorVersion": 0,
              "internalDestinationName": "runID",
              "externalSourceName": "PolicyRunID",
              "required": false,
              "multipleValuesProcessingMode": "PassValuesIntoOneField"
            }
          ],
          "kustoQuery": "let PendingTaskState = \"Pending\";\nlet SucceededTaskState = \"Succeeded\";\nlet _startTime = startofweek(queryFrom);\nBlobInventorySloTable\n| where DispatchTime between (_startTime..queryTo) and AccountName == storageAccountName and isnotempty(storageAccountName) and PolicyRunId has runID\n| summarize arg_max(TIMESTAMP, ManifestTaskState, DispatchTime, AccountType, InventoryFormat, BilledObjectsCount, ObjectCountFromBilling) by TaskId, RuleName\n| extend TaskDuration = iff(ManifestTaskState == PendingTaskState, now() - DispatchTime, TIMESTAMP - DispatchTime)\n| where not(ManifestTaskState == PendingTaskState and TaskDuration < 1d)\n| extend MeetSLO = ManifestTaskState == SucceededTaskState and TaskDuration < 1d, true, false\n| summarize RunCount=count(), SloMet = countif(MeetSLO == true), SloNotMet = countif(MeetSLO == false), percentile(BilledObjectsCount, 50), percentile(ObjectCountFromBilling, 50) by InventoryFormat, AccountType, RuleName\n| extend MetSloRetio = round(100. * SloMet / (SloMet + SloNotMet), 3)",
          "panelPath": [
            "Account Rules Status & SLO"
          ]
        }
      ]
    },
