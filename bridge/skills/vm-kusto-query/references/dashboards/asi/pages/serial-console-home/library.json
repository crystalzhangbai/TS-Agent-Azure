    "Gateway Health Check Failure Percentage": {
      "panelPath": [
        "Gateway Health Check Failure Percentage"
      ],
      "queries": [
        {
          "id": "62558b60-adc1-4f20-b4da-59d76886b730",
          "name": "Gateway To RP Healthcheck",
          "groupId": "def1fc20-1e5f-47a1-b686-cdbc3ee0df87",
          "majorVersion": 3,
          "minorVersion": 0,
          "cluster": "azlinux.kusto.windows.net",
          "database": "SerialConsole",
          "type": "TimeSeries",
          "widgetType": "TimeSeries",
          "widgetTitle": "Gateway Health Check Failure Percentage",
          "params": [
            {
              "name": "queryFrom",
              "type": "datetime",
              "optional": false
            },
            {
              "name": "queryTo",
              "type": "datetime",
              "optional": false
            }
          ],
          "schema": [
            {
              "name": "RPTenant",
              "type": "string"
            },
            {
              "name": "ratio",
              "type": "real"
            },
            {
              "name": "healthy_time_bin",
              "type": "datetime"
            }
          ],
          "inputMappings": [
            {
              "source": "asi_values",
              "majorVersion": 0,
              "minorVersion": 0,
              "internalDestinationName": "queryFrom",
              "externalSourceName": "globalFrom",
              "required": false
            },
            {
              "source": "asi_values",
              "majorVersion": 0,
              "minorVersion": 0,
              "internalDestinationName": "queryTo",
              "externalSourceName": "globalTo",
              "required": false
            }
          ],
          "kustoQuery": "let totalCount = HttpAccessLog\r\n| where activitytimestamp > queryFrom\r\n| where activitytimestamp <= queryTo\r\n| where log contains \"/healthcheck HTTP/1.1\"\r\n| summarize total_count = count() by RPTenant, total_time_bin=bin(activitytimestamp, 1h);\r\nlet healthyCount = HttpAccessLog\r\n| where activitytimestamp > queryFrom\r\n| where activitytimestamp <= queryTo\r\n| where log contains \"/healthcheck HTTP/1.1\\\" 200 2\"\r\n| summarize healthy_count = count() by RPTenant, healthy_time_bin=bin(activitytimestamp, 1h);\r\ntotalCount\r\n| join kind=inner healthyCount on $left.total_time_bin == $right.healthy_time_bin, RPTenant\r\n| extend ratio = (1.0 - round(1.0 * healthy_count/total_count, 3))*100\r\n| project RPTenant, ratio, healthy_time_bin\r\n",
          "panelPath": [
            "Gateway Health Check Failure Percentage"
          ]
        }
      ]
    },
