          "groupId": "f06cff2a-a236-4eec-8a64-4f7bbf2beaa8",
          "majorVersion": 2,
          "minorVersion": 1,
          "cluster": "icmcluster",
          "database": "IcMDataWarehouse",
          "type": "Table",
