              "type": "string"
            },
            {
              "name": "Status",
              "type": "string"
            }
          ],
          "inputMappings": [],
          "kustoQuery": "let tenantName=\"AzTux\";\r\nlet owningTeam=\"AZLINUX\\\\AzSerialConsole\";\r\ndatabase(\"IcMDataWarehouse\").Incidents\r\n| where Lens_IngestionTime > ago(3d) and OwningTeamName == owningTeam\r\n| summarize argmax(Lens_IngestionTime, *) by IncidentId\r\n| where max_Lens_IngestionTime_Severity <= 4\r\n| project IncidentId, CreateDate=max_Lens_IngestionTime_CreateDate, MitigatedDate=max_Lens_IngestionTime_MitigateDate, Title=max_Lens_IngestionTime_Title, Severity=max_Lens_IngestionTime_Severity, OwningTeam=max_Lens_IngestionTime_OwningTeamName, Status=max_Lens_IngestionTime_Status\r\n| where CreateDate > ago(60d)\r\n| where Status != \"RESOLVED\"\r\n| order by Status asc, CreateDate desc",
          "panelPath": [
            "ICM Incidents"
          ]
        }
      ]
