            {
              "source": "Query_ColumnFromSingleRow",
              "groupId": "eeb71e3c-726e-4e38-ad23-cb7b13b9e53b",
              "majorVersion": 4,
              "minorVersion": 1,
              "internalDestinationName": "queryCorrelationId",
              "externalSourceName": "correlationId",
              "required": false,
