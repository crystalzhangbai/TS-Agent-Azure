    "id": "84225de8-09d4-4c88-b0b1-fc5f62411b06",
    "name": "AsyncQoSEvents Search by operationName",
    "groupId": "28af80db-b9c2-4328-b441-f2d67a8c90d3",
    "majorVersion": 8,
    "minorVersion": 0,
    "cluster": "azcrp.kusto.windows.net",
    "database": "vmimagebuilder",
    "type": "Table",
    "dataSource": "Kusto",
    "language": "KQL",
    "kustoQuery": "AsyncQoSEvents\r\n| where PreciseTimeStamp between (queryFrom .. queryTo)\r\n| where operationName == Operation\r\n| where Result == \"\" or result == Result\r\n| where iff(resultTypeFilter != \"\", resultType == resultTypeFilter, true)\r\n| project PreciseTimeStamp, correlationID, operationID, level, result, resultType, serviceBuild, errorDetails, subscriptionID\r\n| where iff(subscription != \"\", subscriptionID == subscription, true)\r\n| take 1000",
    "params": [
      {
        "name": "queryFrom",
        "description": "The ASI team recommends that all queries have a start and end time and these are linked to the GlobalTime",
