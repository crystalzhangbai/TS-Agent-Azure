[
  {
    "id": "734f609f-0f9a-4d42-aa39-900be8469d3d",
    "name": "Daily Build Success Rate",
    "groupId": "5cdb941c-a698-4ccf-b424-6f7e53d8a93e",
    "majorVersion": 4,
    "minorVersion": 1,
    "cluster": "azcrp.kusto.windows.net",
    "database": "vmimagebuilder",
    "type": "TimeSeries",
    "dataSource": "Kusto",
    "language": "KQL",
    "kustoQuery": "AsyncQoSEvents\r\n| where PreciseTimeStamp between (queryFrom .. queryTo)\r\n// | where not(IsAIBSubscription(subscriptionID))\r\n| where iff(build != \"\", serviceBuild == build, true)\r\n| summarize\r\n    callCount=todouble(count()),\r\n    clientFailures=countif(resultType == 1),\r\n    serverFailures=countif(resultType == 2),\r\n    // failures=countif(resultType != 0),\r\n    failedSubs=dcountif(subscriptionID, resultType != 0)\r\n    by bin(PreciseTimeStamp, binTime)\r\n| extend successRate = round(((callCount - clientFailures - serverFailures) * 100 ) / (callCount - clientFailures), 2)\r\n| project PreciseTimeStamp, successRate, clientFailures, serverFailures\r\n",
    "params": [
      {
        "name": "queryFrom",
        "description": "The ASI team recommends that all queries have a start and end time and these are linked to the GlobalTime",
        "type": "datetime",
        "default": "2025-02-05T00:00:00.000Z",
        "optional": false,
        "useTestValueAsDefault": false,
        "typeSpecificOptions": {
          "enumTypeData": "[]"
        },
        "displayConditions": []
      },
      {
        "name": "queryTo",
        "description": "The ASI team recommends that all queries have a start and end time and these are linked to the GlobalTime",
        "type": "datetime",
        "default": "2025-03-05T00:00:00.000Z",
        "optional": false,
        "useTestValueAsDefault": false,
        "typeSpecificOptions": {
          "enumTypeData": "[]"
        },
        "displayConditions": []
      },
      {
        "name": "binTime",
        "description": "",
        "type": "timespan",
        "default": "30m",
        "optional": false,
        "useTestValueAsDefault": false,
        "typeSpecificOptions": {
          "enumTypeData": "[]"
        },
        "displayConditions": []
      },
      {
        "name": "build",
        "description": "",
        "type": "string",
        "optional": false,
        "useTestValueAsDefault": false,
        "typeSpecificOptions": {
          "enumTypeData": "[]"
        },
        "displayConditions": []
      }
    ],
    "schema": [
      {
        "name": "PreciseTimeStamp",
        "type": "datetime"
      },
      {
        "name": "successRate",
        "type": "real"
      },
      {
        "name": "clientFailures",
        "type": "long"
      },
      {
        "name": "serverFailures",
        "type": "long"
      }
    ],
    "serviceId": "Azure VM Image Builder"
  },
  {
